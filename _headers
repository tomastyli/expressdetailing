# Cloudflare Pages - HTTP hlavičky
# Dokumentace: https://developers.cloudflare.com/pages/configuration/headers/

# Obrázky a fonty: dlouhá cache, soubory se nemění
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon a manifest
/favicon.ico
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# HTML: vždy ověřit aktuálnost
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Bezpečnostní hlavičky pro celý web
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
